{
  "version": 1,
  "rules": [
    {
      "id": "markdown-files",
      "statement": "Project Markdown exists only in the two contract files and vendored skills.",
      "why": "AGENTS.md: These are the only two non-skill Markdown files in the repo.",
      "severity": "block",
      "kind": "file_policy",
      "scope": [
        "**"
      ],
      "enforcedBy": {
        "file": "lib/security/repoGuardrails.test.ts",
        "test": "enforces markdown-files"
      },
      "check": "markdown",
      "allowed": [
        "AGENTS.md",
        "docs/MASTER-PLAN-PROGRESS.md",
        ".agents/skills/**"
      ]
    },
    {
      "id": "model-clients",
      "statement": "Product code never imports a model SDK or calls a model API host.",
      "why": "AGENTS.md Product (Felipe, 2026-10-01): ShipLock pays for no intelligence and makes no model API calls of its own; the customer's agent over MCP is the only AI path.",
      "severity": "block",
      "kind": "forbidden_pattern",
      "scope": [
        "app/**",
        "lib/**",
        "components/**",
        "mcp/**",
        "proxy.ts"
      ],
      "enforcedBy": {
        "file": "lib/security/repoGuardrails.test.ts",
        "test": "enforces model-clients"
      },
      "check": "model-clients"
    },
    {
      "id": "model-keys",
      "statement": "Product code never reads a model API key or a funded-call switch.",
      "why": "AGENTS.md Product (Felipe, 2026-10-01): no ShipLock key in any path, no customer API key mode, and the funded first scan is retired.",
      "severity": "block",
      "kind": "forbidden_pattern",
