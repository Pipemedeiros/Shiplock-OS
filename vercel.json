{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ':(exclude)docs' ':(exclude).agents' ':(exclude)*.md'",
  "regions": [
    "pdx1"
  ],
  "crons": [
    {
      "path": "/api/monitor/scheduled",
      "schedule": "0 9 * * *"
    }
  ]
}
