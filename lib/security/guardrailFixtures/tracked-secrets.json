{
  "rule": "tracked-secrets",
  "cases": [
    {
      "name": "Stripe",
      "expectedPath": "config.txt",
      "edits": [
        {
          "path": "config.txt",
          "content": "sk_live_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
        }
      ]
    },
    {
      "name": "Anthropic",
      "expectedPath": "config.txt",
      "edits": [
        {
          "path": "config.txt",
          "content": "sk-ant-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ]
    },
    {
      "name": "GitHub classic",
      "expectedPath": "config.txt",
      "edits": [
        {
          "path": "config.txt",
          "content": "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        }
      ]
    },
    {
      "name": "GitHub PAT",
      "expectedPath": "config.txt",
      "edits": [
        {
          "path": "config.txt",
          "content": "github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        }
      ]
    },
    {
      "name": "Resend",
      "expectedPath": "config.txt",
      "edits": [
        {
          "path": "config.txt",
          "content": "re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        }
      ]
    },
    {
      "name": "JWT",
      "expectedPath": "config.txt",
      "edits": [
        {
          "path": "config.txt",
          "content": "eyJaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbb.ccccccccccccccccccccccccc"
        }
      ]
    },
    {
      "name": "private key",
      "expectedPath": "config.txt",
      "edits": [
        {
          "path": "config.txt",
          "content": "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC7VJTUt9Us8cKj\n-----END PRIVATE KEY-----"
        }
      ]
    },
    {
      "name": "test files are not secret exemptions",
      "expectedPath": "lib/security/rogue.test.ts",
      "edits": [
        {
          "path": "lib/security/rogue.test.ts",
          "content": "const key=\"ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\";"
        }
      ]
    },
    {
      "name": "split secret",
      "expectedPath": "lib/security/key.ts",
      "edits": [
        {
          "path": "lib/security/key.ts",
          "content": "const key=\"gh\"+\"p_\"+\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\";"
        }
      ]
    }
  ]
}
