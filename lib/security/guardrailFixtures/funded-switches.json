{
  "rule": "funded-switches",
  "cases": [
    {
      "name": "default-on switch",
      "expectedPath": "lib/funding.ts",
      "edits": [
        {
          "path": "lib/funding.ts",
          "replace": {
            "from": "=== \"true\"",
            "to": "!== \"false\""
          }
        }
      ]
    },
    {
      "name": "deleted gate with fake comment",
      "expectedPath": "lib/analyzer.ts",
      "edits": [
        {
          "path": "lib/analyzer.ts",
          "replace": {
            "from": "if (!shiplockFundedCallAllowed(\"scan-report\")) return buildFallback(scan);",
            "to": "// if (!shiplockFundedCallAllowed(\"scan-report\")) return buildFallback(scan);"
          }
        }
      ]
    },
    {
      "name": "new aliased caller",
      "expectedPath": "app/api/funding-bypass/route.ts",
      "edits": [
        {
          "path": "app/api/funding-bypass/route.ts",
          "content": "import { proposeAttacks as run } from \"@/lib/agent/attack\"; export const POST = run;"
        }
      ]
    },
    {
      "name": "re-export hides caller",
      "expectedPath": "lib/security/fundingBarrel.ts",
      "edits": [
        {
          "path": "lib/security/fundingBarrel.ts",
          "content": "export { proposeAttacks as run } from \"@/lib/agent/attack\";"
        }
      ]
    },
    {
      "name": "dynamic caller",
      "expectedPath": "app/api/funding-bypass/route.ts",
      "edits": [
        {
          "path": "app/api/funding-bypass/route.ts",
          "content": "const mod = \"@/lib/agent/\" + \"attack\"; const engine = await import(mod); engine.proposeAttacks({});"
        }
      ]
    },
    {
      "name": "unknown dynamic caller",
      "expectedPath": "app/api/funding-bypass/route.ts",
      "edits": [
        {
          "path": "app/api/funding-bypass/route.ts",
          "content": "const engine = await import(process.env.MODULE); engine.run();"
        }
      ]
    }
  ]
}
