{
  "rule": "verified-findings",
  "cases": [
    {
      "name": "deleted enforcing file",
      "expectedPath": "lib/agent/attack.verify.test.ts",
      "edits": [
        {
          "path": "lib/agent/attack.verify.test.ts",
          "remove": true
        }
      ]
    },
    {
      "name": "comments preserve the name and assertion markers",
      "expectedPath": "lib/agent/attack.verify.test.ts",
      "edits": [
        {
          "path": "lib/agent/attack.verify.test.ts",
          "commentAll": true
        }
      ]
    },
    {
      "name": "assertion gutted with the test name intact",
      "expectedPath": "lib/agent/attack.verify.test.ts",
      "edits": [
        {
          "path": "lib/agent/attack.verify.test.ts",
          "replace": {
            "from": "expect(",
            "to": "void ("
          }
        }
      ]
    },
    {
      "name": "skipped test",
      "expectedPath": "lib/agent/attack.verify.test.ts",
      "edits": [
        {
          "path": "lib/agent/attack.verify.test.ts",
          "replace": {
            "from": "it(",
            "to": "it.skip("
          }
        }
      ]
    },
    {
      "name": "build from raw proposals",
      "expectedPath": "lib/agent/audit.ts",
      "edits": [
        {
          "path": "lib/agent/audit.ts",
          "replace": {
            "from": "admitted: verified,",
            "to": "admitted: agent.admitted,"
          }
        }
      ]
    }
  ]
}
