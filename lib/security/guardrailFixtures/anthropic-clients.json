{
  "rule": "anthropic-clients",
  "cases": [
    {
      "name": "aliased constructor",
      "expectedPath": "lib/security/rogueModel.ts",
      "edits": [
        {
          "path": "lib/security/rogueModel.ts",
          "content": "import Model from \"@anthropic-ai/sdk\"; new Model();"
        }
      ]
    },
    {
      "name": "dynamic module string",
      "expectedPath": "lib/security/rogueModel.ts",
      "edits": [
        {
          "path": "lib/security/rogueModel.ts",
          "content": "const mod = \"@anthropic\" + \"-ai/sdk\"; const { default: Model } = await import(mod); new Model();"
        }
      ]
    },
    {
      "name": "CommonJS runtime import",
      "expectedPath": "lib/security/rogueModel.ts",
      "edits": [
        {
          "path": "lib/security/rogueModel.ts",
          "content": "const { default: Model } = require(\"@anthropic-ai/sdk\"); new Model();"
        }
      ]
    },
    {
      "name": "barrel re-export",
      "expectedPath": "lib/security/rogueModel.ts",
      "edits": [
        {
          "path": "lib/security/rogueModel.ts",
          "content": "export { default as Innocent } from \"@anthropic-ai/sdk\";"
        }
      ]
    }
  ]
}
