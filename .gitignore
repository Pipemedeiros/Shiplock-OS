# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP package deps (published separately)
mcp/node_modules/

# Claude Code machine-local settings and the agent skills Felipe works with
# locally are not repo policy.
.claude/
.agents/skills/

# Audit working data owned by the corpus/census agent. The vendored customer-repo
# copies (218MB) and the 21MB witness dump are reproducible from the pinned
# archives pinned in docs/CORPUS.json; retired prose is recoverable in Git history.

# Reacquirable checksum-verified evaluation archives and raw per-run inputs.
.cache/shiplock-corpus/
docs/evaluation/runs/*
# A8's labeled batches (192 KB, no source): gate-total recomputes the gate from them.
!docs/evaluation/runs/a8-corpus6-2026-10/
!docs/evaluation/runs/corpus7-release-2026-10/
!docs/evaluation/runs/attempt4-2026-10/
!docs/evaluation/runs/attempt5-2026-10/

# python
__pycache__/
*.pyc

# local working memory: names production state, never published
docs/MASTER-PLAN-PROGRESS.md
