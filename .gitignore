# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP package deps (published separately)
mcp/node_modules/

# Ignore the large machine-local skill catalog. The small curated SKILL.md files
# already tracked for both agents are retained despite this ignore rule.
.claude/skills/

# Audit working data owned by the corpus/census agent. The vendored customer-repo
# copies (218MB) and the 21MB witness dump are reproducible from the pinned
# archives in docs/STATE.md "Corpus provenance"; the markdown beside them is committed.
docs/audit/source/
docs/audit/gate-census-witnesses.json

# Reacquirable checksum-verified evaluation archives and raw per-run inputs.
.cache/shiplock-corpus/
.cache/step23-sql/
docs/evaluation/runs/
