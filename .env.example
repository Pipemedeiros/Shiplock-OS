# Copy to .env.local. Required keys are checked at startup by lib/env.ts.

# Supabase (system of record and sign in)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# openssl rand -base64 32  (must decode to exactly 32 bytes)
ENCRYPTION_KEY=
# Shared secret for /api/jobs/drain and the scheduled routes
CRON_SECRET=

# Email (required by the schema; alert emails are switched off in lib/access.ts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# GitHub App: needed to audit a repository.
# Setup URL: <app>/api/deep/github/callback  Webhook: <app>/api/monitor/github
# Private key is the downloaded .pem (newlines as \n are fine).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Worker (npm run worker:audit), when not using the pg_cron job of migration 094
SHIPLOCK_BASE_URL=http://localhost:3000

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
